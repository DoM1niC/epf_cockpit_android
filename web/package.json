{
  "name": "epf-cockpit-web",
  "version": "0.1.0",
  "private": true,
  "description": "Telemetry dashboard for the EPF Cockpit Android e-scooter app. Receives live BLE telemetry over WebSocket, stores in SQLite, serves live dashboard / OBS widget / trip history views.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "build:css": "tailwindcss -i public/css/tailwind.css -o public/dist/app.css --minify",
    "build:vendor": "node scripts/copy-vendor.js",
    "build": "npm run build:vendor && npm run build:css",
    "start": "node src/server.js",
    "test": "DB_PATH=:memory: node --test test/"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "uplot": "^1.6.32",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
