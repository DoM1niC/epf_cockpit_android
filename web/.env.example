# Web server bind
PORT=8787
BIND_ADDR=0.0.0.0
# When running behind nginx, bind to loopback so only nginx reaches Node:
#BIND_ADDR=127.0.0.1

DB_PATH=./data/epf.db

# --- Shared-token authentication -------------------------------------------
# Both tokens are independently optional. If a value is empty/unset that side
# is OPEN (no auth). Recommended: generate with `openssl rand -hex 32`.

# Required on /ws/ingest (Android app side).
# Pass via:
#   - URL query: ws://host:port/ws/ingest?token=...
#   - Authorization: Bearer <token>
INGEST_TOKEN=

# Required on /, /obs, /history, /api/*, /ws/live (browser side).
# Bookmarks need ?token=...; the page stashes it in sessionStorage so
# in-tab navigation doesn't lose it.
VIEW_TOKEN=
