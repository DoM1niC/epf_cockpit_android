<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Optionales Trip-Tracking via AOSP-LocationManager (kein FusedLocation,
         keine Play-Services). Wird zur Laufzeit nur dann angefordert wenn der
         User den Standortverfolgung-Toggle in den Settings einschaltet.
         FINE + COARSE Pflichtkombi ab API 31: Android verlangt beide, sonst
         downgradet das System FINE silently auf COARSE — und Lint wirft
         CoarseFineLocation. Wir fordern zur Laufzeit nur FINE an. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Foreground-Service hält BLE-GATT lebendig solange der Service läuft;
         der Notification-Slot zeigt km/h + Akku. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- foregroundServiceType="location" auf dem FGS braucht ab API 34 eine
         eigene Permission, sonst wirft startForeground SecurityException sobald
         der Service-Typ "location" mit drin steht. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Damit das Cockpit auch bei längerer Standby-Zeit nicht vom Doze-Mode
         eingefroren wird, bitten wir den User aktiv um Akku-Whitelist. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Kurze Partial-WakeLocks: aktive Reconnect-Versuche im Hintergrund,
         Re-Auth direkt nach einem Reconnect, und der Heartbeat bei Display aus —
         letzterer nur, nachdem eine CPU-Suspend-Lücke gemessen wurde. delay()
         steht im CPU-Suspend, ein Foreground-Service hält die CPU nicht wach. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- NFC nur fuer das Diagnose-Tool (NfcReadScreen) — lesen, niemals
         schreiben. required=false: App laeuft auch auf Geraeten ohne NFC,
         das Feature ist dann halt nicht sichtbar/nutzbar. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:name=".EpfApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EpfCockpit"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.EpfCockpit.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Cockpit-Foreground-Service: hält BLE-Connection + zeigt Live-Notification.
             foregroundServiceType=connectedDevice ist Pflicht ab API 34 für FGS,
             die ein verbundenes Bluetooth-Gerät weiter bedienen.
             "|location" kommt dazu damit der optionale LocationCollector während
             der Fahrt GPS-Waypoints holen darf — der FGS-Typ muss alle Use-Cases
             abdecken, sonst SecurityException sobald wir requestLocationUpdates
             aufrufen während die App im Hintergrund läuft. -->
        <service
            android:name=".service.EpfConnectionService"
            android:foregroundServiceType="connectedDevice|location"
            android:exported="false" />

        <!-- Quick-Tile: Schnelleinstellungs-Kachel "E-Scooter entsperren".
             Bind-Permission ist System-Pflicht damit nur SystemUI den
             Tile-Service starten darf. -->
        <service
            android:name=".widget.UnlockTileService"
            android:exported="true"
            android:icon="@drawable/ic_notif_scooter"
            android:label="@string/tile_unlock_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Quick-Tile: Frontlicht ein/aus (nur bei entsperrtem Roller). -->
        <service
            android:name=".widget.LightTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_light"
            android:label="@string/tile_light_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Home-Screen-Widget: Entsperren + Modus-Toggle. -->
        <receiver
            android:name=".widget.UnlockWidgetProvider"
            android:exported="true"
            android:label="@string/widget_unlock_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/unlock_widget_info" />
        </receiver>
    </application>
</manifest>
